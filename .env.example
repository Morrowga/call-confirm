# ---- Runtime ----
APP_ENV=test                     # test | production — selects which credential set is live
DEBUG=true
API_BASE_URL=http://localhost:8000

# ---- Database / cache (local dev points at compose containers) ----
DATABASE_URL=postgresql+asyncpg://callconfirm:callconfirm@db:5432/callconfirm
REDIS_URL=redis://redis:6379/0
# Production example (RDS/ElastiCache managed endpoints):
# DATABASE_URL=postgresql+asyncpg://user:pass@your-rds.rds.amazonaws.com:5432/callconfirm
# REDIS_URL=redis://your-elasticache.cache.amazonaws.com:6379/0

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Twilio: FULLY SEPARATE test and production credentials ----
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TWILIO_PROD_ACCOUNT_SID=
TWILIO_PROD_AUTH_TOKEN=
TWILIO_DEMO_NUMBER=              # the single shared system demo number (E.164)
TWILIO_WEBHOOK_BASE_URL=         # public https URL Twilio can reach

# ---- Stripe: FULLY SEPARATE test and production credentials ----
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_PROD_SECRET_KEY=
STRIPE_PROD_WEBHOOK_SECRET=
STRIPE_PRICE_PANEL_BASE=         # $5/mo price ID
STRIPE_PRICE_API_BASE=           # $10/mo price ID
STRIPE_PRICE_METERED_CALL=       # $0.0199/call metered price ID
STRIPE_PRICE_VOICE_ADDON=        # $1/mo price ID

# ---- AWS ----
AWS_REGION=ap-southeast-1
S3_BUCKET=callconfirm-media
# AWS credentials via instance role in prod / aws configure locally

# ---- Bulk upload AI column mapping (optional; heuristic fallback if unset) ----
ANTHROPIC_API_KEY=

# ---- Notifications (Phase 1: log backend by default) ----
NOTIFICATION_BACKEND=log         # log | smtp
